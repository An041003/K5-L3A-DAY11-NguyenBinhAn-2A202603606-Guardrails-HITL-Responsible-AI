# Fill in the two API keys, then run from this repository root.
# Blue: fixed OpenRouter liquid/lfm-3-1.7b:free (lab requirement).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Red and Red Advance: direct OpenAI / GPT-4o-mini.
RED_TEAM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional direct Gemini provider for Red; unused with provider=openai.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=0
GEMINI_MODEL=gemini-3.5-flash

NEMO_GUARDRAILS_NO_USAGE_STATS=1

# Cap completion tokens per model request.
LLM_MAX_OUTPUT_TOKENS=1024
